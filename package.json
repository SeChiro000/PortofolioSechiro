{
  "name": "portofolio-art",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "cf:preview": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv worker-configuration.d.ts",
    "cf:d1:migrate:local": "wrangler d1 migrations apply sechiro-portfolio-guestbook --local",
    "cf:d1:migrate:prod": "wrangler d1 migrations apply sechiro-portfolio-guestbook --remote"
  },
  "dependencies": {
    "@react-three/drei": "^9.105.6",
    "@react-three/fiber": "^8.16.6",
    "framer-motion": "^11.1.7",
    "next": "14.2.35",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "three": "^0.164.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "18.2.55",
    "@types/react-dom": "18.2.19",
    "@types/three": "^0.164.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "ts-node": "^10.9.2",
    "typescript": "5.8.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  }
}
